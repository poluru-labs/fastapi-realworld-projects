APP_NAME=Code Execution API
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local default is a SQLite file. Compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./code_execution.db

ADMIN_API_KEY=dev-admin-key-change-me
RUNNER_API_KEY=dev-runner-key-change-me
