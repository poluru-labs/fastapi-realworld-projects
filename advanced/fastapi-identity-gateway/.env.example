APP_NAME=Identity Gateway API
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

DATABASE_URL=sqlite+aiosqlite:///./identity_gateway.db
ADMIN_API_KEY=dev-admin-key-change-me
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CLIENT_SECRET_PEPPER=dev-client-pepper-change-me
TOKEN_ISSUER=http://127.0.0.1:8000
TOKEN_AUDIENCE=identity-gateway
AUTHORIZATION_CODE_TTL_MINUTES=10
