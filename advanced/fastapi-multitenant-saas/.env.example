APP_NAME=Multitenant SaaS API
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SECRET_KEY=dev-only-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FREE_PLAN_PROJECT_LIMIT=3

# Local default is a SQLite file. Compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./saas.db
